## .gitignore para proyectos .NET

# Carpetas de compilación
bin/
obj/

# Archivos de usuario de Visual Studio
*.user
*.suo
*.userosscache
*.sln.docstates

# Carpetas de Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.DotSettings.user

# Archivos de compilación adicionales
*.dll
*.pdb
*.cache

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Sistema operativo
.DS_Store
Thumbs.db
